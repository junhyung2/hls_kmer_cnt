TARGET   ?= hw
PLATFORM  = xilinx_u50_gen3x16_xdma_5_202210_1

KERNEL    = kmer_count_sram
HOST_EXE  = host_sram_$(TARGET)
KRNL_SRC  = src/kmer_count_sram.cpp
HOST_SRC  = src/host_sram.cpp
XO_FILE   = $(KERNEL)_$(TARGET).xo
XCLBIN    = $(KERNEL)_$(TARGET).xclbin

ifeq ($(TARGET), sw_emu)
  CFG_FILE     = connectivity_hw_emu_sram.cfg
  KRNL_DEFINES = -DSW_EMU
else ifeq ($(TARGET), hw_emu)
  CFG_FILE     = connectivity_hw_emu_sram.cfg
  KRNL_DEFINES = -DHW_EMU
else ifeq ($(TARGET), hw)
  CFG_FILE     = connectivity_hw_sram.cfg
  KRNL_DEFINES =
else
  $(error Unknown TARGET=$(TARGET). Use: sw_emu | hw_emu | hw)
endif

XILINX_XRT   ?= /opt/xilinx/xrt
XILINX_VITIS ?= /tools/Xilinx/Vitis/2022.1
VPP           = $(XILINX_VITIS)/bin/v++

VPP_COMMON = --platform $(PLATFORM) --target $(TARGET) --save-temps \
             -I src

VPP_COMPILE_FLAGS = $(VPP_COMMON) $(KRNL_DEFINES)
VPP_LINK_FLAGS    = $(VPP_COMMON) --config $(CFG_FILE)

CXXFLAGS = -std=c++17 -O2 -Wall \
            -DSRAM_HT_BITS_HOST=18 \
            -I$(XILINX_XRT)/include \
            -I src
LDFLAGS  = -L$(XILINX_XRT)/lib -lxrt_coreutil -lpthread -luuid

.PHONY: all kernel host clean

all: kernel host

kernel: $(XCLBIN)

$(XO_FILE): $(KRNL_SRC) src/kmer_count_sram.h
	@echo ">>> [v++ compile] TARGET=$(TARGET) KERNEL=$(KERNEL)"
	$(VPP) -c $(VPP_COMPILE_FLAGS) -k $(KERNEL) -o $@ $<

$(XCLBIN): $(XO_FILE) $(CFG_FILE)
	@echo ">>> [v++ link] TARGET=$(TARGET)"
	$(VPP) -l $(VPP_LINK_FLAGS) -o $@ $<

host: $(HOST_EXE)

$(HOST_EXE): $(HOST_SRC) src/kmer_count_sram.h
	@echo ">>> [g++ host] TARGET=$(TARGET)"
	g++ $(CXXFLAGS) -o $@ $< $(LDFLAGS)

clean:
	rm -f $(KERNEL)_*.xo $(KERNEL)_*.xclbin host_sram_* *.json *.log *.pb
	rm -f *.link_summary *.compile_summary
	rm -rf _x .Xil
